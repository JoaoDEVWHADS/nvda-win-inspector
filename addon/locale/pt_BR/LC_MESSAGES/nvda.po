msgid "&Download and Install"
msgstr "&Baixar e Instalar"

msgid "&Close"
msgstr "&Fechar"

msgid "Downloading update... Please wait."
msgstr "Baixando atualização... Por favor, aguarde."

msgid "Error: Failed to download update"
msgstr "Erro: Falha ao baixar a atualização"

msgid "Error: Failed to install update"
msgstr "Erro: Falha ao instalar a atualização"

msgid "Error: Update failed. Check NVDA log for details."
msgstr "Erro: Falha na atualização. Verifique o log do NVDA para detalhes."

msgid "Update installed successfully! NVDA needs to restart."
msgstr "Atualização instalada com sucesso! O NVDA precisa reiniciar."

msgid "Update Installed"
msgstr "Atualização Instalada"

msgid "Update failed because files are in use.\n"
"\n"
"Please RESTART NVDA and try updating immediately,\n"
"\n"
"WITHOUT opening the add-on settings."
msgstr "A atualização falhou porque os arquivos estão em uso.\n"
"\n"
"Por favor, REINICIE o NVDA e tente atualizar imediatamente,\n"
"\n"
"SEM abrir as configurações do complemento."

msgid "Update Failed - Files Locked"
msgstr "Falha na Atualização - Arquivos Bloqueados"

msgid "Update failed because files are in use.\n"
"\n"
"Please RESTART NVDA and try updating immediately,\n"
"\n"
"WITHOUT opening the volume control dialog."
msgstr "A atualização falhou porque os arquivos estão em uso.\n"
"\n"
"Por favor, REINICIE o NVDA e tente atualizar imediatamente,\n"
"\n"
"SEM abrir o diálogo do controle de volume."

msgid "Window Inspector"
msgstr "Inspetor de Janelas"

msgid "[No Window]"
msgstr "[Sem Janela]"

msgid "[No Class]"
msgstr "[Sem Classe]"

msgid "Window: {winName}, class: {wClass}"
msgstr "Janela: {winName}, classe: {wClass}"

msgid "Announces the name of the foreground window and the window class name of the focused object."
msgstr "Anuncia o nome da janela em primeiro plano e a classe da janela do objeto focado."

msgid "Update Available - Window Inspector"
msgstr "Atualização Disponível - Window Inspector"

msgid "A new version of Window Inspector is available!\n"
"\n"
"Current version: {current}\n"
"New version: {new}\n"
"\n"
"Click 'Download and Install' to update automatically."
msgstr "Uma nova versão do Window Inspector está disponível!\n"
"\n"
"Versão atual: {current}\n"
"Nova versão: {new}\n"
"\n"
"Clique em 'Baixar e Instalar' para atualizar automaticamente."

msgid "Window Inspector has been updated to version {version}.\n"
"\n"
"NVDA must be restarted for the update to take effect.\n"
"\n"
"Restart NVDA now?"
msgstr "O Window Inspector foi atualizado para a versão {version}.\n"
"\n"
"O NVDA deve ser reiniciado para que a atualização surta efeito.\n"
"\n"
"Reiniciar o NVDA agora?"

